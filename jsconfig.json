{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "lib": [ "ES2022" ],
    "moduleResolution": "Node16",
    "types": [ "node" ],
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true
  },
  "include": [ "**/*.js" ],
  "exclude": [ "node_modules" ]
}